# ==============================================================================
# LearnTrack - Root .gitignore
# ==============================================================================

# Environment variable files (Strictly ignore all local & secret files)
.env
.env.local
.env.*.local
*.env
*.env.*
!.env.example
!*.env.example

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js, Frontend Build Outputs & Turbopack
.next/
out/
build/
dist/
coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, ML Caches & Coverage
.pytest_cache/
.coverage
htmlcov/
*.lcov
.cache/

# MLflow, Experiment Tracking & Checkpoints
mlruns/
*.skops

# Local databases & SQLite
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.pem
*.key
*.cert

# Temporary files
tmp/
temp/

# Agent & assistant caches
.agents/
skills-lock.json

# Vercel & Deployment
.vercel/

# Docker
docker-compose.override.yml
