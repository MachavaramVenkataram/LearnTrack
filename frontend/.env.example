# ==============================================================================
# LearnTrack - Frontend Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development. Never commit real keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Provider AI Architecture (Server-Side Only)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_ENABLE_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. Supabase Infrastructure (Auth, Database, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false

# ------------------------------------------------------------------------------
# 3. Machine Learning Microservice (FastAPI)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_ML_SERVICE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 4. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
