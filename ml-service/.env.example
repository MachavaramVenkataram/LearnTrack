# ==============================================================================
# LearnTrack ML Service - Environment Configuration (.env.example)
# Copy to .env in ml-service/ for local FastAPI development or container deployment.
# ==============================================================================

# Server binding
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development

# Allowed CORS origins (comma-separated, strictly configure in production)
# In development: http://localhost:3000,http://127.0.0.1:3000
# In production: https://learntrack.com,https://app.learntrack.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Artifact and Data directories (defaults to local relative paths)
# ARTIFACTS_DIR=/app/ml/artifacts
# DATA_DIR=/app/ml/data

# Rate limiting
RATE_LIMIT_PREDICT_PER_MINUTE=60
RATE_LIMIT_SIMULATE_PER_MINUTE=120

# MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=learntrack-student-performance
PRODUCTION_MODEL_NAME=learntrack-student-performance
PRODUCTION_MODEL_VERSION=1

# Drift Monitoring Thresholds (Population Stability Index - PSI)
DRIFT_WARNING_THRESHOLD=0.10
DRIFT_CRITICAL_THRESHOLD=0.25
